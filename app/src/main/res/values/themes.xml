<resources>
    <!--
      Платформенная тема: весь интерфейс рисует Compose, XML нужен только окну.
      Ни AppCompat, ни Material Components в рантайме больше не участвуют.
    -->
    <style name="AppTheme" parent="android:Theme.Material.Light.NoActionBar">
        <item name="android:windowBackground">@color/md_theme_light_background</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:windowLightStatusBar">true</item>
    </style>
</resources>
